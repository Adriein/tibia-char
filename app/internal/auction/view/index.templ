package view

import "github.com/adriein/tibia-char/internal/auction/model"


templ Index(auctions []*model.Auction) {
  <html>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

			<title>Tibia Char</title>

			<link rel="icon" type="image/x-icon" href="/assets/images/golden_helmet.ico">
			<link rel="stylesheet" href="/assets/css/main.css">
		</head>
		<body>
			<section>
				@Auctions(auctions)
			</section>
		</body>
	</html>
}