package view

import (
	"strings"
	"fmt"

	"github.com/adriein/tibia-char/internal/auction/model"
	"github.com/adriein/tibia-char/pkg/enums"
	"github.com/adriein/tibia-char/pkg/helper/str"
	"github.com/adriein/tibia-char/pkg/middleware"
	"time"
)

/**
+-------------+-----------------------------------+---------------------------------------------------------+
| SECTION     | CONTENT                           | INSIGHT / WHY?                                          |
+-------------+-----------------------------------+---------------------------------------------------------+
| Header      | Level, Vocation, Name             | Immediate identity recognition. The "hook" for the user.|
+-------------+-----------------------------------+---------------------------------------------------------+
| Main Body   | Base Skill + Charm Points         | Displays the two biggest value drivers that cannot be   |
|             |                                   | easily rushed or bought cheaply.                        |
+-------------+-----------------------------------+---------------------------------------------------------+
| Icons Row   | T3 Imbuements, Soul War, Quests   | The "Gatekeepers." Reduces friction by showing which    |
|             |                                   | boring "chore quests" are already finished.             |
+-------------+-----------------------------------+---------------------------------------------------------+
| Footer      | Price, Time Left, Transfer Status | Actionable data. Provides the urgency and logistical    |
|             |                                   | feasibility needed to decide on a bid.                  |
+-------------+-----------------------------------+---------------------------------------------------------+
*/

templ AuctionCard(auction *model.Auction) {
	{{
		loc, ok := ctx.Value(middleware.TimezoneKey).(*time.Location)

		if !ok {
			loc = time.UTC
		}

		prettyDate := auction.AuctionEnd.In(loc).Format("Jan 02, 2006 at 15:04")
		abbr, _ := auction.AuctionEnd.In(loc).Zone()

		auctionEnd := fmt.Sprintf("%s (%s)", prettyDate, abbr)
	}}
	<div class="card card--auction">
		<div class="card__header">
			<div class="card__header-avatar">
				<img alt="Auction icon" src={auction.Img}/>
			</div>
			<div>
				<h1 class="card__title">{auction.CharName}</h1>
				<h2 class="card__subtitle">{auction.CharLevel} {auction.CharVocation.Name}</h2>
			</div>
		</div>
		<div class="card__subheader">
			<div class="card__subheader-section">
				<div class="card__subheader-bid-amount">
					<img src="https://static.tibia.com/images/charactertrade/objects/37317.gif"/>
					<span>{auction.Bid} TC</span>
				</div>
				<div class="world">
					<img
						class="card__subheader-country-flag"
						alt="Country flag"
						src={fmt.Sprintf("/assets/images/%s.png", str.CamelToSnake(strings.ReplaceAll(auction.CharWorld.Location, " ", "")))}
					/>
					<p>{auction.CharWorld.Name}</p>
					if auction.WorldTransfer {
						<svg class="card__subheader-transfer--allowed" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-world-check"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20.946 12.99a9 9 0 1 0 -9.46 7.995" /><path d="M3.6 9h16.8" /><path d="M3.6 15h13.9" /><path d="M11.5 3a17 17 0 0 0 0 18" /><path d="M12.5 3a16.997 16.997 0 0 1 2.311 12.001" /><path d="M15 19l2 2l4 -4" /></svg>
					} else {
						<svg class="card__subheader-transfer--forbidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-world-cancel"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M21 12a9 9 0 1 0 -8.985 9" /><path d="M3.6 9h16.8" /><path d="M3.6 15h9.9" /><path d="M11.5 3a17 17 0 0 0 0 18" /><path d="M12.5 3a16.991 16.991 0 0 1 2.53 10.275" /><path d="M19 19m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /><path d="M17 21l4 -4" /></svg>
					}
				</div>
			</div>
			<div class="card__subheader-section">
				<div class="card__subheader-bid-time">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-clock"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M12 7v5l3 3" /></svg>
					<span>{auctionEnd}</span>
				</div>
				<div class="world">
					if auction.CharWorld.BattleEye == enums.BattleEyeGreen {
						<img alt="Green battle eye" src="https://static.tibia.com/images/global/content/icon_battleyeinitial.gif"/>
					} else {
						<img alt="Yellow battle eye" src="https://static.tibia.com/images/global/content/icon_battleye.gif"/>
					}
					<p>{strings.ReplaceAll(auction.CharWorld.Pvp, "Pvp", "")}</p>
				</div>
			</div>
		</div>
		<div class="card__body">
			<div class="card__body-skills-container">
				<div class="skill-item">
					<div>
						<img alt="axe fighting" src="/assets/images/stonecutter_axe.png"/>
						<p>Axe</p>
					</div>
					<span>{auction.Skills.Axe}</span>
				</div>
				<div class="skill-item">
					<div>
						<img alt="club fighting" src="/assets/images/thunder_hammer.png"/>
						<p>Club</p>
					</div>
					<span>{auction.Skills.Club}</span>
				</div>
				<div class="skill-item">
					<div>
						<img alt="distance fighting" src="/assets/images/soulbleeder.png"/>
						<p>Distance</p>
					</div>
					<span>{auction.Skills.Distance}</span>
				</div>
				<div class="skill-item">
					<div>
						<img alt="fishing" src="/assets/images/fishing_rod.png"/>
						<p>Fishing</p>
					</div>
					<span>{auction.Skills.Fishing}</span>
				</div>
				<div class="skill-item">
					<div>
						<img alt="fist fighting" src="/assets/images/grand_sanguine_claws.png"/>
						<p>Fist</p>
					</div>
					<span>{auction.Skills.Fist}</span>
				</div>
				<div class="skill-item">
					<div>
						<img alt="magic level" src="/assets/images/spell_book.png"/>
						<p>Magic Level</p>
					</div>
					<span>{auction.Skills.MagicLevel}</span>
				</div>
				<div class="skill-item">
					<div>
						<img alt="shielding" src="/assets/images/demon_shield.png"/>
						<p>Shielding</p>
					</div>
					<span>{auction.Skills.Shielding}</span>
				</div>
				<div class="skill-item">
					<div>
						<img alt="sword fighting" src="/assets/images/magic_sword.png"/>
						<p>Sword</p>
					</div>
					<span>{auction.Skills.Sword}</span>
				</div>
			</div>
		</div>
		<div class="card__featured-items">
			for i := range 4 {
				if i+1 > len(auction.FeaturedItems) {
					<div class="featured-item">
						<img
							alt="empty slot"
							class="featured-item-img--empty"
							src="https://static.tibia.com/images/charactertrade/objects/2865.gif"
						/>
					</div>
				} else {
					<div class="featured-item">
						<img
							alt={auction.FeaturedItems[i].ItemID}
							class="featured-item-img"
							src={fmt.Sprintf("https://static.tibia.com/images/charactertrade/objects/%d.gif", auction.FeaturedItems[i].ItemID)}
						/>
					</div>
				}
			}
		</div>
		<div class="card__info">
			<div class="card__info-item">
				<img alt="Charm point icon" src="https://static.tibia.com/images//charactertrade/charms/icon-charmpoints.png"/>
				<span>Charm Points:</span>
				<span>{auction.Charm.Points}</span>
			</div>
		</div>
		<div class="card__footer">
			<a
				target="_blank"
				href={fmt.Sprintf("https://www.tibia.com/charactertrade/?subtopic=currentcharactertrades&page=details&auctionid=%d", auction.AuctionID)}
			>
				<button class="btn btn--primary">View on Tibia.com</button>
			</a>
		</div>
	</div>
}

templ Auctions(auctions []*model.Auction) {
	<div>
		for _, auction := range auctions {
    	@AuctionCard(auction)
  	}
	</div>
}